{
  "name": "studiox",
  "version": "1.0.0",
  "description": "StudioX - marketplace for the creative industry (MVP)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node prisma/seed.js",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "setup": "prisma migrate dev --name init && node prisma/seed.js",
    "db:deploy": "prisma migrate deploy && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@prisma/client": "^6.16.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
